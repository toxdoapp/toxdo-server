# Copia este archivo como .env para trabajar en tu computador.
# En Render estas variables se configuran en el panel, sección Environment.

PORT=3000

# Clave de Anthropic. Se crea en https://console.anthropic.com en la sección API Keys.
ANTHROPIC_API_KEY=

# Modelo principal. Si se deja vacío se usa Claude Fable.
# ANTHROPIC_MODEL=claude-fable-5-2
# Modelo del asistente dentro de la app. Vacío usa el principal.
# ANTHROPIC_MODEL_ASSISTANT=

# Credencial de servicio de Firebase, en una sola línea de JSON o en base64.
FIREBASE_SERVICE_ACCOUNT=

# Secreto para las rutas /api/admin. Debe tener 12 caracteres o más.
SCRAPE_SECRET=

# Opcionales
# INGEST_ENTITIES_PER_DAY=8
# EVENT_CITIES_PER_DAY=25
# ASSISTANT_PER_USER_PER_DAY=40
# DISABLE_CRON=1
